  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "amqplib": "^0.10.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "redis": "^5.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}