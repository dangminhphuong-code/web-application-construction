{
  "name": "course-service",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:docker": "npm run migrate && npm run seed && node src/server.js",
    "dev": "nodemon src/server.js",
    "consumer:enrollment": "node src/enrollmentEventConsumer.js",
    "worker:outbox": "node src/outboxWorker.js",
