PORT=3004
JWT_SECRET=your_jwt_secret_key
CORS_ORIGIN=http://localhost:5173

RABBITMQ_URL=amqp://app:app123@rabbitmq:5672
COURSE_EVENTS_EXCHANGE=course.events
COURSE_EVENTS_EXCHANGE_TYPE=topic
COURSE_EVENT_ROUTING_KEY=course.enrolled_count.increased
NOTIFICATION_QUEUE=notification.course.enrolled_count.increased.queue
RABBITMQ_PREFETCH=1

REDIS_URL=redis://redis:6379
NOTIFICATION_EVENT_DEDUP_TTL_SECONDS=86400